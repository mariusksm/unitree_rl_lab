# Top-level packages of the sim2sim environment (Python 3.10 = the system Python of the group workstations).
# Lock after a change (on a workstation, so that the shared uv cache is used):
#   uv pip compile sim2sim/requirements.in --python /usr/bin/python3.10 --generate-hashes -o sim2sim/requirements.txt
mujoco==3.10.0        # same version as the shared conda env gmr on both workstations
numpy==2.2.6          # same as gmr
onnxruntime==1.22.0   # same version as the C++ deploy (deploy/thirdparty/onnxruntime-linux-x64-1.22.0)
pyyaml==6.0.3         # reads params/deploy.yaml and params/env.yaml of a run
imageio==2.37.4
imageio-ffmpeg==0.6.0 # brings its own ffmpeg binary (workstation 2 has none installed)
